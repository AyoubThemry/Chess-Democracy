{
  "name": "chess-hive",
  "version": "0.1.0",
  "description": "Global And Local P2P Chess Democracy",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts"
  },
  "keywords": [
    "p2p",
    "decentralized",
    "chess",
    "democracy",
    "networking",
    "typescript",
    "research"
  ],
  "author": "AyoubThemry",
  "license": "MIT",
  "devDependencies": {
    "@types/chess.js": "^0.13.7",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "chess.js": "^1.4.0",
    "ws": "^8.18.3"
  }
}
